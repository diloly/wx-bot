{
  "dry_run": true,
  "send_delay_seconds": 5,
  "contacts": [
    { "name": "示例客户A", "tags": ["new"] },
    { "name": "示例客户B", "tags": ["old", "vip"] }
  ],
  "templates": {
    "welcome": "您好 {name}，我是小助手，后续有疑问随时找我～",
    "followup": "Hi {name}，上周说的方案您看过了吗？需要我补充资料不？"
  },
  "tasks": [
    {
      "id": "daily_followup",
      "template": "followup",
      "tag": "old",
      "cron": "0 10 * * *",
      "enabled": false
    },
    {
      "id": "ai_weekend_vip",
      "ai": true,
      "intent": "给VIP老客户做个轻松的周末问候，顺带问问最近用得怎么样",
      "tag": "vip",
      "cron": "30 18 * * 5",
      "enabled": false
    }
  ],
  "auto_reply": {
    "enabled": true,
    "dry_run": true,
    "interval_seconds": 5,
    "intent": "你正在微信上回复客户发来的消息，目的是激活客户（让沉默的客户愿意重新聊、在用的愿意续费扩购）。语气自然、简洁、口语化，像真人一对一聊天；客户问的产品细节只引用系统提示词里给的资料，资料没有的说'我确认一下再回复你'，不编造。只输出回复正文，不要解释。",
    "contacts": [],
    "allow_groups": true,
    "merge_window_seconds": 10,
    "confirm_timeout_seconds": 6,
    "context_turns": 3,
    "context_hours": 6,
    "rhythm": "natural",
    "max_replies_per_hour": 20,
    "reply_types": ["文本"],
    "task_timeout_seconds": 120,
    "queue_max": 200,
    "emoji_enabled": false,
    "image_rules": []
  },
  "ai": {
    "persona": "小光",
    "company": "中照金智（广州）数据科技",
    "product": "AI照明工作站（A站）",
    "positioning": "为设计提效的 AI SaaS 平台"
  },
  "moment": {
    "max_actions_per_day": 0,
    "ai_comment": true,
    "refresh_interval": 3600,
    "refresh_dwell": 4,
    "task_timeout_seconds": 120
  },
  "add_friend": {
    "enabled": false,
    "daily_limit": 10,
    "interval_min_seconds": 480,
    "interval_max_seconds": 900,
    "work_start_hour": 9,
    "work_end_hour": 21,
    "weekend_factor": 0.5,
    "max_consecutive_failures": 3,
    "retry_days": 30,
    "first_touch_delay_min": 60,
    "first_touch_delay_max": 120,
    "first_touch_intent": "你正在微信上给一位**刚通过好友验证、还没说过话**的联系人写第一条消息（自我介绍 + 破冰）。\n身份：你是「小光」，中照金智（广州）数据科技的在线顾问；公司做的是**为设计提效的 AI SaaS 平台**，核心产品是「AI照明工作站」（简称 A站）——帮照明/建筑/室内/景观设计师用 AI 出照明效果图、动态光影和方案汇报物料。\n必须守的红线：① 我们卖的是 SaaS 平台/工具，**不是接设计项目的外包服务商**，绝不说“我们可以帮您做设计/接项目/代出方案”；② 不报价、不谈折扣、不承诺效果和中标率、不催单；③ 不主动说自己是 AI（客户问起才坦然承认）。\n写法：① 第一句自报身份——小光 + 中照金智 + A站是干什么的，一句话说完，不要念公司简介；② 第二句说来意，优先结合给出的背景（来源/备注），没有就泛到行业，**绝不编造**对方的项目、公司、职位；③ 第三句给一个具体可感知的价值点 + 低压钩子，比如“需要的话我发份介绍给您看看”；④ 口语化、像真人一对一打招呼，总长 80 字以内，不用“尊敬的”，不堆功能词；⑤ 只输出消息正文，不要前后缀、不要引号。\n参考风格（照意思改写，不要照抄）：“您好，我是中照金智的小光，我们做 AI 照明设计工具 A站，主要帮设计师快速出照明效果图和方案汇报物料。看您这边做照明，需要的话我发份介绍给您看看？”"
  },
  "ui": {
    "lock_timeout_seconds": 180
  },
  "outreach": {
    "enabled": false,
    "daily_limit": 0,
    "per_run_limit": 10,
    "interval_min_seconds": 600,
    "interval_max_seconds": 1800,
    "boot_grace_seconds": 600,
    "work_start_hour": 8,
    "work_end_hour": 21,
    "silent_days": 7,
    "max_days": 0,
    "min_gap_days": 7,
    "cycle_days": 0,
    "max_per_contact": 3,
    "lookback_days": 180,
    "include_new_contacts": false,
    "require_switch": false,
    "intent": ""
  },
  "knowledge": {
    "dir": "knowledge",
    "mode": "auto",
    "max_chars": 12000,
    "top_k": 3
  },
  "handoff": {
    "enabled": true,
    "targets": [],
    "watch_scope": "activated",
    "watch_days": 7,
    "cooldown_hours": 24,
    "detector": "ai",
    "pause_auto_reply": true,
    "skip_ai_reply": true
  },
  "contact_sync": {
    "friend_whitelist": []
  },
  "dashboard": {
    "port": 5000,
    "db_path": "wechat_monitor.db"
  }
}
